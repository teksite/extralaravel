{
    "name": "teksite/extralaravel",
    "description": "A collection of reusable utilities, validation rules, middleware, Eloquent casts, traits, Artisan commands, helpers, and developer tools for Laravel applications.",
    "keywords": [
        "laravel",
        "laravel-package",
        "validation-rules",
        "helpers",
        "api",
        "api-validation",
        "soft-delete",
        "trash",
        "phone-verification",
        "honeypot",
        "slug"
    ],
    "authors": [
        {
            "name": "Sina Zangiband",
            "email": "sina.zangiband@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Teksite\\Extralaravel\\": "src/"
        },
        "files": [
            "./src/helper.php"
        ]
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "morilog/jalali": "^3.5"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.5"
    },
    "suggest": {
        "laravel/sanctum": "Required for the expired token pruning step of the cache:purge command."
    },

    "autoload-dev": {
        "psr-4": {
            "Teksite\\Extralaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Teksite\\Extralaravel\\ExtraLaravelServiceProvider"
            ]
        }
    }
}
